# Local Hugging Face models are used by default; no API key is required.
# Keep any provider key here (never in frontend/.env files) if you add a remote generator.
# OPENAI_API_KEY=

# Optional runtime configuration
# RAG_DEVICE=cuda
# DENSE_MODEL=BAAI/bge-base-en-v1.5
# RERANKER_MODEL=BAAI/bge-reranker-base
# Skip generation when the top reranked passage score is below this value (0–1).
# Tested cutoff: in-corpus queries ~0.5+, off-corpus queries ~0.002.
# RERANKER_SCORE_THRESHOLD=0.3
# GENERATOR_MODEL=google/flan-t5-base
# Keep startup fully offline after the initial model download. Set false only to download missing models.
RAG_LOCAL_MODELS_ONLY=true
# CORS_ORIGINS=http://localhost:5173
